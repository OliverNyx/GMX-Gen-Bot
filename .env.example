# Proxy list (one host:port:user:pass per line) — auto-used if proxy.txt exists
PROXY_FILE=proxy.txt
PROXY_MAX_TRIES=40

# Or single proxy:
PROXY=host:port:user:pass
# Or: PROXY_HOST= PROXY_PORT= PROXY_USER= PROXY_PASS=
# iProyal passwords with _country- / _session-: set ROTATE_PROXY_SESSION=true for new IP per account
ROTATE_PROXY_SESSION=false

# Capzy or 2Captcha API key (CaptchaFoxTask)
CAPZY_API_KEY=
# 2Captcha: https://api.2captcha.com — leave empty for Capzy default
CAPTCHA_API_URL=

# CapSkip local solver (optional; run gmxgen with -no-capskip=false)
CAPSKIP_URL=http://127.0.0.1:8080
CAPSKIP_KEY=

# Optional manual CaptchaFox token (skips CapSkip)
CAPTCHA_TOKEN=
